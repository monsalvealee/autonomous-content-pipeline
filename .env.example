# Copiá este archivo a .env y completá tus valores. NUNCA subas .env a git.

# --- Anthropic (cerebro de los agentes de texto) ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6

# --- Pexels (b-roll de stock gratis) → https://www.pexels.com/api/ ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- TTS local ---
TTS_ENGINE=kokoro
TTS_VOICE=af_heart
TTS_DEVICE=cuda        # 'cuda' si tenés GPU, 'cpu' si no

# --- YouTube ---
YT_CLIENT_SECRETS=config/client_secrets.json
YT_PRIVACY_STATUS=public    # en modo autónomo, 'public'; REVIEW igual fuerza private

# --- Fuentes de temas en tiempo real ---
USE_REALTIME_TOPICS=true     # RSS + Reddit (gratis, sin key)
USE_GOOGLE_TRENDS=false      # true requiere: pip install pytrends

# --- Notificaciones (opcionales; vacías = se omiten) ---
TELEGRAM_BOT_TOKEN=          # de @BotFather
TELEGRAM_CHAT_ID=            # de api.telegram.org/bot<TOKEN>/getUpdates
DISCORD_WEBHOOK_URL=         # Server Settings → Integrations → Webhooks

# --- Scheduler 24/7 ---
SHORTS_PER_DAY=3
LONGS_PER_DAY=1
LOOP_CHECK_MINUTES=30
HEARTBEAT_HOUR_UTC=12
